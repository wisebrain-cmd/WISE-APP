# Copy this file to .env locally and replace placeholders with real secrets.
# Generate a session secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
NODE_ENV=development
PORT=3000

# Leave DATABASE_URL blank for local SQLite. Production uses shared PostgreSQL.
DATABASE_URL=
PG_POOL_MAX=5
AGENT_WORKER_ENABLED=true
AGENT_POLL_MS=5000
AGENT_CONCURRENCY=2

# Local development prints confirmation/reset links to the server console.
# Production uses Resend; keep the API key server-side.
EMAIL_PROVIDER=console
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM="WSE Adventures <accounts@example.com>"
# Optional local-only outbox file path, useful for a development smoke run.
EMAIL_LOG_PATH=

# Comma-separated existing account IDs to grant administrator access at startup.
# Register the account first, then obtain its numeric ID from trusted server-side
# storage and configure it here. Email addresses alone do not grant privileges.
ADMIN_USER_IDS=

# Hybrid AI providers. Keep these keys on the server only. Never put them in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# GitHub repository access for the server-side agent integration.
# Fine-grained token: Contents read/write, Pull requests read/write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=wisebrain-cmd/WISE-APP
