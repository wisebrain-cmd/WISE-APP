# Copy this file to .env locally and replace the placeholder with a random secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=45210881d343a57c410093638eea8d34d35cefae184175cdfaa8d405b48f42a5
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Local only: log account emails to the server console instead of delivering via SMTP.
EMAIL_DELIVERY=console

# SMTP account email delivery (needed for verification and password resets).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
