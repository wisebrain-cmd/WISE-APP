# Copy this file to .env locally and replace placeholders with real secrets.
# Generate a session secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
NODE_ENV=development
PORT=3000

# Hybrid AI providers. Keep these keys on the server only. Never put them in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
